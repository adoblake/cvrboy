<section><div class="collection-hero"><div class="page-width"><div class="issue-no">CVRBOY / COLLECTION</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div></div><div class="page-width"><div class="collection-grid product-grid">{% paginate collection.products by 24 %}{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products yet.</p>{% endfor %}{% endpaginate %}</div></div></section>{% schema %}{"name":"Collection","settings":[]}{% endschema %}