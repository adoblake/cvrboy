<header class="site-header"><div class="page-width header-inner"><a class="brand" href="{{ routes.root_url }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 320 | image_tag: class: 'brand-logo', alt: shop.name }}{% else %}CVRBOY{% endif %}</a><nav class="nav" aria-label="Primary"><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ section.settings.new_link | default: routes.all_products_collection_url }}">New</a><a href="/#issues">Issues</a><a href="/pages/lookbook">Lookbook</a><a href="/pages/story">Story</a></nav><div class="header-actions"><a href="{{ routes.search_url }}">Search</a><button class="icon-btn" data-cart-open>Bag (<span data-cart-count>{{ cart.item_count }}</span>)</button></div></div></header>{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"new_link","label":"New arrivals link"}]}{% endschema %}