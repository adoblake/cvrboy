<section class="story-page"><div class="page-width"><div class="issue-no">CVRBOY / BAG</div><h1>Your Bag</h1>{% if cart.item_count == 0 %}<p>Your bag is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop CVRBOY</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div class="eyebrow">{{ item.variant.title }}</div><label>Qty <input style="width:60px" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}</div><div class="cart-total"><div class="cart-total-row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><button class="btn" type="submit" name="update">Update bag</button> <button class="btn" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</div></section>{% schema %}{"name":"Cart","settings":[]}{% endschema %}