<section class="story-page"><div class="page-width"><div class="issue-no">CVRBOY / SEARCH</div><h1>Find your thing.</h1><form action="{{ routes.search_url }}" method="get" role="search"><div class="newsletter-row" style="max-width:720px"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="SEARCH CVRBOY"><button type="submit">→</button></div></form>{% if search.performed %}<div class="section"><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>No products found.</p>{% endfor %}</div></div>{% endif %}</div></section>{% schema %}{"name":"Search","settings":[]}{% endschema %}