<section class="hero"><div class="hero-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '720,1200,1600,2000', sizes: '(min-width: 990px) 72vw, 100vw' }}{% else %}<div class="hero-fallback"><div class="bubble-logo"><span>CVR<br>BOY</span></div></div>{% endif %}</div><div class="hero-copy"><div><div class="issue-no">{{ section.settings.kicker }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>{% if section.settings.link != blank %}<a class="btn" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>{% endif %}</div><div class="hero-meta"><div><div class="eyebrow">Mantra</div><div>{{ section.settings.mantra }}</div></div><div><div class="eyebrow">System</div><div>Nerd Utility / For Curious People</div></div></div></div></section>{% schema %}{"name":"Issue hero","settings":[{"type":"image_picker","id":"image","label":"Campaign image"},{"type":"text","id":"kicker","label":"Issue label","default":"ISSUE 001 / ORIGIN"},{"type":"text","id":"heading","label":"Heading","default":"Cover What You Love."},{"type":"textarea","id":"text","label":"Intro","default":"Streetwear for curious people. Built from comics, games, manga, design, music and everything we never grew out of."},{"type":"text","id":"mantra","label":"Mantra","default":"Culture Covers Everything."},{"type":"text","id":"button_label","label":"Button label","default":"Shop Issue 001"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Issue hero"}]}{% endschema %}