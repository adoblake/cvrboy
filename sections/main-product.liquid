<section class="main-product"><div class="product-gallery">{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 45vw, 100vw' }}{% endif %}{% else %}<div class="product-placeholder">CVRBOY / PRODUCT MEDIA</div>{% endfor %}</div><div class="product-pane"><div class="issue-no">{% if product.metafields.cvrboy.issue %}ISSUE {{ product.metafields.cvrboy.issue }}{% else %}CVRBOY / NERD UTILITY{% endif %}</div><h1>{{ product.title }}</h1><div class="product-price">{{ product.price | money }}</div>{% form 'product', product %}<div class="option-group"><label class="eyebrow" for="Variant-{{ section.id }}">Choose option</label><div class="option-values"><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select></div></div><button class="btn" type="submit">Add to bag</button>{% endform %}<div class="source-note"><div class="eyebrow">Source Material</div><p>{{ section.settings.source_note }}</p></div><div style="margin-top:28px">{{ product.description }}</div></div></section>{% schema %}{"name":"Product","settings":[{"type":"textarea","id":"source_note","label":"Source material note","default":"Built from the visual language around us — comics, games, print, music, animation and everyday objects — without becoming costume."}]}{% endschema %}