<section id="issues" class="section"><div class="page-width"><div class="section-head"><div><div class="eyebrow">CVRBOY ARCHIVE</div><h2>Issues, not seasons.</h2></div></div><div class="issues-grid">{% for block in section.blocks %}<a class="issue-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><div><div class="issue-no">{{ block.settings.number }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div><div class="eyebrow">{{ block.settings.cta }} →</div></a>{% endfor %}</div></div></section>{% schema %}{"name":"Issue cards","max_blocks":6,"blocks":[{"type":"issue","name":"Issue","settings":[{"type":"text","id":"number","label":"Issue number","default":"ISSUE 001"},{"type":"text","id":"title","label":"Title","default":"Origin"},{"type":"textarea","id":"text","label":"Text","default":"The first chapter. Everyday pieces with a point of view."},{"type":"text","id":"cta","label":"CTA","default":"Explore issue"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Issue cards","blocks":[{"type":"issue"},{"type":"issue"},{"type":"issue"}]}]}{% endschema %}