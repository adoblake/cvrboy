<section class="section"><div class="page-width"><div class="section-head"><div><div class="eyebrow">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.collection != blank %}<a class="eyebrow" href="{{ section.settings.collection.url }}">View all →</a>{% endif %}</div><div class="product-grid">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<div class="product-card"><div class="product-card-media"><div class="product-placeholder"><span class="eyebrow">CVRBOY / ITEM 0{{ i }}</span></div></div><div class="product-info-row"><div><div class="product-title">Issue 001 Product</div><div class="eyebrow">Connect a collection</div></div><div class="product-price">$—</div></div></div>{% endfor %}{% endif %}</div></div></section>{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"NEW / ISSUE 001"},{"type":"text","id":"heading","label":"Heading","default":"The Drop"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"default":4,"label":"Products"}],"presets":[{"name":"Featured products"}]}{% endschema %}