<a class="product-card" href="{{ product.url }}"><div class="product-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 25vw, 50vw' }}{% else %}<div class="product-placeholder"><span class="eyebrow">CVRBOY / ITEM</span></div>{% endif %}</div><div class="product-info-row"><div><div class="product-title">{{ product.title }}</div>{% if product.metafields.cvrboy.issue %}<div class="eyebrow">Issue {{ product.metafields.cvrboy.issue }}</div>{% endif %}</div><div class="product-price">{{ product.price | money }}</div></div></a>